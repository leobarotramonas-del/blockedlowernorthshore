---
import { titleCase } from "../utils/title-case";
import { site } from '../data/site';
interface Props { mode?: 'home' | 'about' | 'contact' | 'services' | 'areas' }
const { mode = 'home' } = Astro.props;
const copy = {
 home: {title:'Know What You Are Agreeing To', intro:'A drain can start flowing again while a damaged joint remains. Before deciding on further work, ask these three questions.', rows:[['What Was Found?', 'Ask what was removed, what could be seen and what remains uncertain. Symptoms alone cannot establish the condition of an underground pipe.'],['What Does This Work Address?', 'Clarify whether the proposed work clears an obstruction, investigates a recurring fault or repairs damaged pipework.'],['What Happens Next?', 'Discuss the flow check, any remaining defect and the signs that should prompt another call.']]},
 about: {title:'Our Approach to a Repair Recommendation', intro:'Good drainage advice connects a finding to a practical next step. Here is how we explain that decision.', rows:[['Evidence First', 'We consider symptoms, accessible inspection findings and pipe condition. Where visibility or access is limited, that uncertainty matters to the recommendation.'],['A Defined Scope', 'The immediate clearing task and any structural repair are explained separately. Access, materials and surface reinstatement belong in the repair discussion.'],['A Result You Understand', 'Flow checks help establish whether the immediate restriction has been addressed. A remaining fault needs its own explanation and follow-up advice.']]},
 contact: {title:'Have These Details Ready', intro:'You do not need to know the cause. A few observations help us prepare for your call.', rows:[['The Address and Entrance', 'Give the unit or street number, the best entry point and any parking, height or gate restrictions. For shared property, identify who can arrange access.'],['The Pattern', 'Tell us which fixtures are affected, when it began and whether it follows rain or indoor water use. Mention any previous blockages and chemicals already used.'],['The Immediate Risk', 'Explain whether wastewater is overflowing, an essential bathroom is unusable or water is near electrical equipment. Stay clear of hazards while calling.']]},
 services: {title:'Clearing, Inspection or Repair?', intro:'These tasks answer different questions. Your drain may need one, or a sequence of them.', rows:[['Clearing Restores a Passage', 'Mechanical tools or suitable water jetting remove an obstruction. The choice depends on the material, pipe and access.'],['Inspection Explains the Condition', 'A CCTV camera can reveal visible roots, joints and damage in accessible sections. Debris or standing water may need to be cleared first.'],['Repair Addresses a Defect', 'When damaged pipework is identified, locating and access planning help define the section to repair and the work around it.']]},
 areas: {title:'What Changes from Property to Property', intro:'The same symptom can need a different approach at a house, apartment building or business.', rows:[['Shared Drainage', 'Arrange access through the appropriate owner, manager or strata contact. Information from other affected occupants can help identify the extent of the problem.'],['Slopes and Tight Access', 'Steps, retaining walls, narrow side paths and basement entrances affect where equipment can reach. Describe them when arranging the visit.'],['Previous Work', 'A plan, earlier camera findings or details of an extension can help explain the route. Bring what you have; the existing layout still needs assessment.']]},
}[mode];
---
<section class="section work-standards" aria-labelledby={'standards-'+mode}>
 <div><h2 id={'standards-'+mode}>{titleCase(copy.title)}</h2><p>{copy.intro}</p><p class="licence-line">{site.operator}<br />NSW Contractor Licence <strong>{site.licence}</strong></p><a href={mode === 'about' ? '/contact/' : '/about/'}>{mode === 'about' ? 'Discuss Your Drain' : 'About the Licensed Provider'}</a></div>
 <dl class="field-register">{copy.rows.map(([title,text])=><div><dt>{title}</dt><dd>{text}</dd></div>)}</dl>
</section>
