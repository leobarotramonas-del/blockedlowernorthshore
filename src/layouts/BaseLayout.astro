---
import { titleCase } from '../utils/title-case';
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-600.css';
import '@fontsource/barlow/latin-700.css';
import '@fontsource/saira-extra-condensed/latin-700.css';
import bodyFont from '@fontsource/barlow/files/barlow-latin-400-normal.woff2?url';
import headingFont from '@fontsource/saira-extra-condensed/files/saira-extra-condensed-latin-700-normal.woff2?url';
import '../styles/global.css';


import Breadcrumbs from '../components/Breadcrumbs.astro';
import Header from '../components/Header.astro';
import CallBar from '../components/CallBar.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { pageSchema } from '../data/schema';

interface Props {
  article?: boolean;
  articleImage?: string;
  articleImageAlt?: string;
  title: string;
  description: string;
  canonicalPath?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  showFooter?: boolean;
  noindex?: boolean;
}

const { article = false, articleImage, articleImageAlt, title, description, canonicalPath = Astro.url.pathname, schema, showFooter = true, noindex = false } = Astro.props;
const baseUrl = Astro.site!.href;
const allowIndexing = import.meta.env.PROD && import.meta.env.PUBLIC_ALLOW_INDEXING === 'true' && !noindex;
const enableAnalytics = import.meta.env.PROD && import.meta.env.PUBLIC_ALLOW_INDEXING === 'true';
const canonical = new URL(canonicalPath, baseUrl).toString();
const socialImage = articleImage ? new URL(articleImage, Astro.site).href : new URL('/images/blocked-drains.webp', baseUrl).href;
const pageTitle = article ? title : titleCase(title.includes(site.shortName) ? title : `${title} | ${site.shortName}`);
const structuredData = pageSchema(baseUrl, canonicalPath, pageTitle, description, schema);
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    {enableAnalytics && <>
      <script is:inline define:vars={{ measurementId: site.analyticsId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', measurementId);
        // Queue measurement immediately; let essential page assets finish first.
        let analyticsStarted = false;
        function loadAnalytics() {
          if (analyticsStarted) return;
          analyticsStarted = true;
          const script = document.createElement('script');
          script.async = true;
          script.fetchPriority = 'low';
          script.src = 'https://www.googletagmanager.com/gtag/js?id=' + measurementId;
          document.head.appendChild(script);
        }
        window.addEventListener('load', loadAnalytics, { once: true });
        document.addEventListener('pointerdown', loadAnalytics, { once: true, passive: true });
        document.addEventListener('keydown', loadAnalytics, { once: true });
        document.addEventListener('visibilitychange', function () {
          if (document.visibilityState === 'hidden') loadAnalytics();
        });
        document.addEventListener('click', function (event) {
          const link = event.target instanceof Element ? event.target.closest('a[href^="tel:"]') : null;
          if (!link) return;
          loadAnalytics();
          const placement = link.closest('.mobile-call-bar') ? 'mobile_call_bar'
            : link.closest('.mobile-menu') ? 'mobile_menu'
            : link.closest('header') ? 'header'
            : link.closest('footer') ? 'footer' : 'page_content';
          gtag('event', 'phone_click', {
            send_to: measurementId,
            link_url: link.getAttribute('href'),
            button_location: placement
          });
        });
      </script>
    </>}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={allowIndexing ? 'index,follow,max-image-preview:large' : 'noindex,nofollow'} />
    <meta name="theme-color" content="#071A35" />
    <meta name="geo.region" content="AU-NSW" />
    <meta name="geo.placename" content="The Lower North Shore, New South Wales" />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" sizes="150x150" href="/favicon-antons.png" />
    <link rel="apple-touch-icon" sizes="300x300" href="/apple-touch-icon.png" />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={articleImageAlt ?? "Drain plumber using professional blocked-drain equipment"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Drain plumber using professional blocked-drain equipment" />
    {!noindex && <><link rel="canonical" href={canonical} /><link rel="alternate" hreflang="en-AU" href={canonical} /><link rel="alternate" hreflang="x-default" href={canonical} /></>}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to Main Content</a>
    <Header />
    <main id="main" class:list={{ 'inner-page': canonicalPath !== '/' }}>{!article && <Breadcrumbs path={canonicalPath} />}<slot /></main>
    {showFooter && <Footer />}
    <CallBar />
  </body>
</html>
