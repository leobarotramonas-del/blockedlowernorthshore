---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---
<BaseLayout title="Website Terms" description="Read the Antons Blocked Drains Lower North Shore website terms covering service information, licensed operation, urgent situations, pricing and availability.">
  <article class="legal-page"><h1>Website Terms</h1><p>Last updated 19 October 2026.</p><h2>Service Information</h2><p>This website provides general information about blocked-drain diagnosis, clearing and repair. It is not a quote, site-specific diagnosis or guarantee of availability.</p><h2>Service Provider</h2><p>Antons Blocked Drains Lower North Shore is provided by {site.operator}. Regulated work is performed under NSW contractor licence {site.licence}.</p><h2>Urgent Situations</h2><p>If there is immediate danger, electrical risk, fire or threat to life, leave the area and contact the appropriate emergency service. Calling this business is not a substitute for emergency services.</p><h2>Accuracy</h2><p>We aim to keep service and contact information current, but the specific scope, pricing, repair method and availability must be confirmed directly after the job details are reviewed.</p></article>
</BaseLayout>
