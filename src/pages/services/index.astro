---
import { titleCase } from "../../utils/title-case";
import WorkStandards from '../../components/WorkStandards.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import FaqSection from '../../components/FaqSection.astro';
import { services } from '../../data/site';
import { faqSchema, pageFaqs } from '../../data/faqs';
---
<BaseLayout title="Blocked Drain Services Lower North Shore" description="Explore professional blocked drain services across the Lower North Shore: toilet and sewer clearing, water jetting, CCTV inspections, root removal and drain repairs." schema={faqSchema(pageFaqs.services)}>
  <PageHero label="Drain Services" title="Blocked drain services matched to the cause." intro="Start with the symptom you can see, or explore a method below. We explain what it can address, when another approach may be needed and what to do before the visit." image="/images/drain-camera-inspection.webp" imageAlt="Drain plumber carrying out a CCTV pipe inspection" />
  <section class="section service-directory">
    <p>If you are unsure which service fits, <a href="/contact/">contact the drain team</a> and describe what the drain is doing. You do not need to diagnose it yourself. You can also check our <a href="/service-areas/">Lower North Shore service areas</a>.</p>
    {services.map((service) => <article><h2>{titleCase(service.name)}</h2><p>{service.summary}</p><ul>{service.details.map((detail) => <li>{detail}</li>)}</ul><a class="text-link" href={`/services/${service.slug}/`}>Understand {service.name}</a></article>)}
  </section>
  <WorkStandards mode="services" />
  <FaqSection title="Blocked Drain Service Questions" intro="How clearing, camera inspection, water jetting and repairs fit together." items={pageFaqs.services} />
  <CtaBand title="Not Sure Which Drain Service You Need?" />
</BaseLayout>
